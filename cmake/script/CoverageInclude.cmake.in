find_program(LLVM_COV_EXECUTABLE llvm-cov REQUIRED)
find_program(LLVM_PROFDATA_EXECUTABLE llvm-profdata REQUIRED)
find_program(LLVM_CXXFILT_EXECUTABLE llvm-cxxfilt)

set(COVERAGE_EXCLUDE_REGEX "src/crc32c/|src/leveldb/|src/minisketch/|src/secp256k1/|src/test/|depends/")

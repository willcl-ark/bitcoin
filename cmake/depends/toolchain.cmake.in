set(CMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH OFF)

if(NOT "@BITCOIN_DEPENDS_TARGET_TOOLCHAIN_FILE@" STREQUAL "")
  include("@BITCOIN_DEPENDS_TARGET_TOOLCHAIN_FILE@")
endif()

set(CMAKE_FIND_ROOT_PATH "@BITCOIN_DEPENDS_PREFIX@")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

if(NOT "/" IN_LIST CMAKE_PREFIX_PATH)
  list(APPEND CMAKE_PREFIX_PATH "/")
endif()

set(DEPENDS_COMPILE_DEFINITIONS "")
set(DEPENDS_COMPILE_DEFINITIONS_RELWITHDEBINFO "")
set(DEPENDS_COMPILE_DEFINITIONS_DEBUG "")

set(WITH_USDT @BITCOIN_DEPENDS_ENABLE_USDT@ CACHE BOOL "")
if(@BITCOIN_DEPENDS_ENABLE_USDT@)
  set(USDT_INCLUDE_DIR "@BITCOIN_DEPENDS_PREFIX@/systemtap/include" CACHE PATH "")
endif()

if(@BITCOIN_DEPENDS_WITH_IPC@)
  set(MPGEN_EXECUTABLE "@BITCOIN_DEPENDS_NATIVE_PREFIX@/bin/mpgen" CACHE FILEPATH "")
  set(CAPNP_EXECUTABLE "@BITCOIN_DEPENDS_NATIVE_PREFIX@/bin/capnp" CACHE FILEPATH "")
  set(CAPNPC_CXX_EXECUTABLE "@BITCOIN_DEPENDS_NATIVE_PREFIX@/bin/capnpc-c++" CACHE FILEPATH "")
endif()

FROM ghcr.io/nixos/nix:2.34.9

COPY ./ci/retry/retry /ci_retry
COPY ./ci/lint/flake.nix ./ci/lint/flake.lock /lint/

RUN nix --extra-experimental-features "nix-command flakes" build \
      --no-update-lock-file --out-link /lint-env path:/lint && \
    mkdir -p /bin /usr/bin && \
    ln -sf /lint-env/bin/bash /bin/sh && \
    ln -sf /lint-env/bin/env /usr/bin/env && \
    ln -sf /lint-env/etc/os-release /etc/os-release

ENV CI_RETRY_EXE="/ci_retry"

WORKDIR /bitcoin
ENTRYPOINT ["/lint-env/bin/with-lint-env"]
CMD ["bash"]

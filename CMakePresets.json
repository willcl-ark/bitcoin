{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Build using 'Visual Studio 18 2026' generator and 'x64-windows' triplet",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolchainFile": "$env{VCPKG_ROOT}\\scripts\\buildsystems\\vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "BUILD_GUI": "ON",
        "WITH_ZMQ": "ON"
      }
    },
    {
      "name": "vs2026-static",
      "displayName": "Build using 'Visual Studio 18 2026' generator and 'x64-windows-static' triplet",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolchainFile": "$env{VCPKG_ROOT}\\scripts\\buildsystems\\vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "BUILD_GUI": "ON",
        "WITH_ZMQ": "ON"
      }
    },
    {
      "name": "libfuzzer",
      "displayName": "Build for fuzzing with libfuzzer, and sanitizers enabled",
      "binaryDir": "${sourceDir}/build_fuzz",
      "cacheVariables": {
        "BUILD_FOR_FUZZING": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-ftrivial-auto-var-init=pattern",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-ftrivial-auto-var-init=pattern",
        "SANITIZERS": "undefined,address,fuzzer"
      }
    },
    {
      "name": "libfuzzer-nosan",
      "displayName": "Build for fuzzing with libfuzzer, and sanitizers disabled",
      "binaryDir": "${sourceDir}/build_fuzz_nosan",
      "cacheVariables": {
        "BUILD_FOR_FUZZING": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "SANITIZERS": "fuzzer"
      }
    },
    {
      "name": "dev-mode",
      "displayName": "Developer mode, with all features/dependencies enabled",
      "binaryDir": "${sourceDir}/build_dev_mode",
      "errors": {"dev": true},
      "cacheVariables": {
        "BUILD_BENCH": "ON",
        "BUILD_CLI": "ON",
        "BUILD_DAEMON": "ON",
        "BUILD_FUZZ_BINARY": "ON",
        "BUILD_GUI": "ON",
        "BUILD_GUI_TESTS": "ON",
        "BUILD_KERNEL_LIB": "ON",
        "BUILD_SHARED_LIBS": "ON",
        "BUILD_TESTS": "ON",
        "BUILD_TX": "ON",
        "BUILD_UTIL": "ON",
        "BUILD_UTIL_CHAINSTATE": "ON",
        "BUILD_WALLET_TOOL": "ON",
        "ENABLE_EXTERNAL_SIGNER": "ON",
        "ENABLE_WALLET": "ON",
        "ENABLE_IPC": "ON",
        "WITH_QRENCODE": "ON",
        "WITH_USDT": "ON",
        "WITH_ZMQ": "ON"
      }
    },
    {
      "name": "ci-common",
      "hidden": true,
      "errors": {"dev": true},
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "BUILD_BENCH": "ON",
        "BUILD_FUZZ_BINARY": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "ci-dev-mode",
      "hidden": true,
      "inherits": ["ci-common", "dev-mode"]
    },
    {
      "name": "ci-arm-linux",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wno-psabi -Wno-error=maybe-uninitialized",
        "REDUCE_EXPORTS": "ON"
      }
    },
    {
      "name": "ci-freebsd-cross",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "REDUCE_EXPORTS": "ON",
        "WITH_USDT": "OFF"
      }
    },
    {
      "name": "ci-i686-no-ipc",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "APPEND_CPPFLAGS": "-DBOOST_MULTI_INDEX_ENABLE_SAFE_MODE",
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_IPC": "OFF"
      }
    },
    {
      "name": "ci-macos-cross",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "REDUCE_EXPORTS": "ON",
        "WITH_USDT": "OFF"
      }
    },
    {
      "name": "ci-macos-native",
      "inherits": "ci-dev-mode",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-stack_size -Wl,0x80000",
        "REDUCE_EXPORTS": "ON",
        "WITH_USDT": "OFF"
      }
    },
    {
      "name": "ci-macos-native-fuzz",
      "inherits": "ci-common",
      "generator": "Ninja",
      "cacheVariables": {
        "APPEND_CPPFLAGS": "-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_DEBUG",
        "BUILD_FOR_FUZZING": "ON",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-stack_size -Wl,0x80000"
      }
    },
    {
      "name": "ci-native-alpine-musl",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "REDUCE_EXPORTS": "ON"
      }
    },
    {
      "name": "ci-native-asan",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "APPEND_CPPFLAGS": "-DARENA_DEBUG -DDEBUG_LOCKORDER",
        "APPEND_CXXFLAGS": "-std=c++23",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-ftrivial-auto-var-init=pattern",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-ftrivial-auto-var-init=pattern",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
        "SANITIZERS": "address,float-divide-by-zero,integer,undefined"
      }
    },
    {
      "name": "ci-native-chimera-lto",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "BUILD_GUI": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "REDUCE_EXPORTS": "ON"
      }
    },
    {
      "name": "ci-native-fuzz",
      "inherits": "ci-common",
      "cacheVariables": {
        "BUILD_FOR_FUZZING": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-ftrivial-auto-var-init=pattern",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-ftrivial-auto-var-init=pattern",
        "SANITIZERS": "fuzzer,address,undefined,float-divide-by-zero,integer"
      }
    },
    {
      "name": "ci-native-fuzz-msan",
      "inherits": "ci-common",
      "cacheVariables": {
        "APPEND_CPPFLAGS": "-DBOOST_MULTI_INDEX_ENABLE_SAFE_MODE -U_FORTIFY_SOURCE",
        "BUILD_FOR_FUZZING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "",
        "CMAKE_C_FLAGS_DEBUG": "",
        "SANITIZERS": "memory"
      }
    },
    {
      "name": "ci-native-fuzz-valgrind",
      "inherits": "ci-common",
      "cacheVariables": {
        "BUILD_FOR_FUZZING": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "ci-native-iwyu",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "BUILD_GUI": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ci-native-msan",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "APPEND_CPPFLAGS": "-U_FORTIFY_SOURCE",
        "BUILD_GUI": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "",
        "CMAKE_C_FLAGS_DEBUG": "",
        "SANITIZERS": "memory"
      }
    },
    {
      "name": "ci-native-nowallet",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "ENABLE_WALLET": "OFF",
        "REDUCE_EXPORTS": "ON",
        "WITH_EMBEDDED_ASMAP": "OFF"
      }
    },
    {
      "name": "ci-native-previous-releases",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "APPEND_CPPFLAGS": "-DBOOST_MULTI_INDEX_ENABLE_SAFE_MODE",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-funsigned-char -Werror",
        "CMAKE_CXX_FLAGS_DEBUG": "-g2 -O2",
        "CMAKE_C_FLAGS": "-funsigned-char -Werror",
        "CMAKE_C_FLAGS_DEBUG": "-g2 -O2",
        "REDUCE_EXPORTS": "ON"
      }
    },
    {
      "name": "ci-native-tidy",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O0 -g0",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O0 -g0",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ci-native-tsan",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "APPEND_CPPFLAGS": "-DARENA_DEBUG -DDEBUG_LOCKCONTENTION -D_LIBCPP_REMOVE_TRANSITIVE_INCLUDES",
        "BUILD_GUI": "OFF",
        "SANITIZERS": "thread"
      }
    },
    {
      "name": "ci-native-valgrind",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "BUILD_GUI": "OFF",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "WITH_USDT": "OFF"
      }
    },
    {
      "name": "ci-s390x",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "REDUCE_EXPORTS": "ON"
      }
    },
    {
      "name": "ci-win64",
      "inherits": "ci-dev-mode",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wno-error=maybe-uninitialized",
        "ENABLE_IPC": "OFF",
        "REDUCE_EXPORTS": "ON",
        "WITH_USDT": "OFF"
      }
    }
  ],
  "testPresets": [
    {
      "name": "ci-unit-tests",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "ci-arm-linux-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-arm-linux"
    },
    {
      "name": "ci-freebsd-cross-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-freebsd-cross"
    },
    {
      "name": "ci-i686-no-ipc-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-i686-no-ipc"
    },
    {
      "name": "ci-macos-cross-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-macos-cross"
    },
    {
      "name": "ci-macos-native-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-macos-native"
    },
    {
      "name": "ci-macos-native-fuzz-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-macos-native-fuzz"
    },
    {
      "name": "ci-native-alpine-musl-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-alpine-musl"
    },
    {
      "name": "ci-native-asan-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-asan"
    },
    {
      "name": "ci-native-chimera-lto-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-chimera-lto"
    },
    {
      "name": "ci-native-fuzz-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-fuzz"
    },
    {
      "name": "ci-native-fuzz-msan-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-fuzz-msan"
    },
    {
      "name": "ci-native-fuzz-valgrind-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-fuzz-valgrind"
    },
    {
      "name": "ci-native-iwyu-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-iwyu"
    },
    {
      "name": "ci-native-msan-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-msan"
    },
    {
      "name": "ci-native-nowallet-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-nowallet"
    },
    {
      "name": "ci-native-previous-releases-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-previous-releases"
    },
    {
      "name": "ci-native-tidy-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-tidy"
    },
    {
      "name": "ci-native-tsan-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-tsan"
    },
    {
      "name": "ci-native-valgrind-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-native-valgrind"
    },
    {
      "name": "ci-s390x-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-s390x"
    },
    {
      "name": "ci-win64-unit-tests",
      "inherits": "ci-unit-tests",
      "configurePreset": "ci-win64"
    }
  ]
}
